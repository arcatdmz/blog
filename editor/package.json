{
  "name": "blog-editor",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "secrets:summary": "node scripts/configure-summary.mjs",
    "test:browser": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "test:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "html-parse-stringify": "^4.0.1",
    "jose": "^6.2.12",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-flexible-code-titles": "^1.3.5",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.141.0"
  }
}
